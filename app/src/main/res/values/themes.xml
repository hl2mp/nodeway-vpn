<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The whole UI is rendered by assets/index.html inside a WebView. -->

    <!--
        Общая часть темы. Само имя Theme.NodewayVPN наследует её без правок,
        а values-v31 переопределяет только экран загрузки — так общие пункты
        остаются в одном месте, а не дублируются в двух файлах.
    -->
    <style name="Theme.NodewayVPN.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nodeway_accent</item>
        <item name="colorPrimaryVariant">@color/nodeway_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nodeway_accent</item>
        <item name="android:windowBackground">@color/nodeway_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!--
            Отказ от принудительной тёмной темы, и единственный пункт, который
            удерживает перекрашивание снаружи приложения.

            Настройка разработчика «Принудительная тёмная тема» (Override
            force-dark) красит окна сама и делает это повторно при каждом
            изменении конфигурации, перебивая настройки WebView: приложение
            выставляет запрет при создании, а система возвращает его обратно.
            Поэтому отказ возможен только здесь — через тему. На Xiaomi тёмная
            тема включается именно так, поэтому тема должна оставаться DayNight.

            Отдельно от этого: системная тёмная тема приложению сообщается как
            обычно, и режим «Как в системе» за ней следует. Проблема была не в
            этом, а в том, что подмена красит окна поверх — даже когда тема
            приложения светлая, и цвета выходят чужие.
        -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.NodewayVPN" parent="Theme.NodewayVPN.Base" />
</resources>
