<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон адаптивной иконки: вертикальный градиент фирменного синего.

    Заливка ровно 108x108 — так и положено: система сама накладывает маску
    (круг, squircle, каплю) и вырезает внешние 18dp с каждой стороны.
    Поверх этого слоя лежит только белое облако из ic_launcher_foreground,
    поэтому при сдвиге фона (параллакс) картинка остаётся цельной.

    Цвета сняты с исходного nodeway.png: сверху #185BDE, снизу #143DBD.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:color="#FF185BDE" android:offset="0" />
                <item android:color="#FF143DBD" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>