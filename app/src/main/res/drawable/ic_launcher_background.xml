<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон адаптивной иконки: тёмный Material 3 градиент.

    Цвета из icon.svg: сверху #28292c, низ #202124. Поверх этого слоя
    лежит белое облако из ic_launcher_foreground, поэтому при сдвиге фона
    (параллакс) картинка остаётся цельной.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF28292c" android:offset="0" />
                <item android:color="#FF202124" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
